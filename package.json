{
  "name": "pageel-crm",
  "type": "module",
  "version": "0.13.7",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:cf": "wrangler pages dev --d1 DB -- astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "lint": "astro check && tsc --noEmit --incremental",
    "lint:sec": "bash scripts/lint-verbose-errors.sh",
    "db:generate": "drizzle-kit generate",
    "db:push:test": "drizzle-kit push",
    "db:push:local": "wrangler d1 migrations apply DB --local",
    "db:deploy": "./scripts/deploy.sh",
    "dev:all": "npm run db:generate && npm run db:push:local && npm run dev"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@libsql/client": "^0.17.4",
    "astro": "^7.4.7",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "wrangler": "^4.158.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jszip": "^3.4.0",
    "@types/node": "^25.9.9",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "esbuild": "^0.28.1"
  }
}
